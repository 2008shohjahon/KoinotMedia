# Example environment variables for KOINOT MEDIA
# Copy this file to .env and fill the secret values. Do NOT commit real secrets to Git.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram channel username (e.g. @kanal_nomi) or chat ID (e.g. -1001234567890)
CHANNEL_ID=

# Google Gemini / Generative AI API key
GEMINI_API_KEY=

# Optional: secret to require Authorization: Bearer <CRON_SECRET> for trigger and cron endpoints
CRON_SECRET=

# Optional: number of articles to publish (3 or 4 recommended)
MAX_ARTICLES=4
